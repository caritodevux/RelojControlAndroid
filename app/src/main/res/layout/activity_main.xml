<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Credencial Digital IoT"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSeleccionModo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Modalidad de funcionamiento"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintStart_toStartOf="parent" />

    <RadioGroup
        android:id="@+id/rgModo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvSeleccionModo"
        app:layout_constraintStart_toStartOf="parent">

        <RadioButton
            android:id="@+id/rbModoDemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DEMO - Sin hardware"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbModoBluetooth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bluetooth - HC-05 real" />

    </RadioGroup>

    <TextView
        android:id="@+id/tvEstadoConexion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="DEMO: Desconectado"
        android:textColor="#D32F2F"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="14dp"
        android:background="#FFEBEE"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/rgModo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etIdEmpleado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Ingrese ID (Ej: EMP-1042)"
        android:text="EMP-1042"
        android:inputType="textCapCharacters"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvEstadoConexion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnConectarBT"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Iniciar demostración"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/etIdEmpleado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnMarcarAsistencia"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="MARCAR ASISTENCIA"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#2E7D32"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/btnConectarBT"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnGoogleLogin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Iniciar sesión con Google"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnMarcarAsistencia"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>