<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Credencial Digital IoT"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvEstadoConexion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Estado: Desconectado"
        android:textColor="#D32F2F"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="14dp"
        android:background="#FFEBEE"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etIdEmpleado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Ingrese ID (Ej: EMP-1042)"
        android:text="EMP-1042"
        android:inputType="textCapCharacters"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvEstadoConexion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnConectarBT"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Conectar a Tótem (HC-05)"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/etIdEmpleado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnMarcarAsistencia"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="MARCAR ASISTENCIA"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#2E7D32"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/btnConectarBT"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>